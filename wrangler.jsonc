{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "worldbrilho",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "worldbrilho-depoimentos"
    }
  ],
  "observability": { "enabled": true }
}
